# Finacle - Environment template
# Copy to `.env` and fill in values. docker compose reads this file automatically.
# Service config classes also load `.env` from each service working directory.

# --- Shared / Database -----------------------------------------------------
DATABASE_URL=postgresql://ledger_app:dev_only@localhost:5432/ledger

# --- Redis (gateway idempotency hot path) -----------------------------------
REDIS_URL=redis://localhost:6379

# --- Ledger Core (Rust gRPC service) ----------------------------------------
LEDGER_CORE_ADDR=localhost:50051
# Log filter for the Rust ledger-core (RUST_LOG syntax)
RUST_LOG=info

# --- Kafka (event stream) ----------------------------------------------------
KAFKA_BROKERS=localhost:9092

# --- OpenAI / embeddings (RAG copilot) ---------------------------------------
# Required for grounded-answer generation and embedding similarity search.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- RAG copilot --------------------------------------------------------------
RAG_TOP_K=8
CHUNK_SIZE=400
CHUNK_OVERLAP=50

# --- API Gateway ---------------------------------------------------------------
# Comma-separated list of "key:merchant_id" pairs for X-API-Key authentication.
# e.g. "sk_live_abc:merchant_1,sk_live_def:merchant_2"
API_KEYS=
LOG_LEVEL=INFO
RATE_LIMIT_PER_SEC=50
IDEMPOTENCY_TTL_SECONDS=86400

# --- Reconciliation / Settlement ---------------------------------------------
# Path to the compiled C++ recon binary (inside the settlement container).
RECON_ENGINE_PATH=/app/recon_engine
POLL_INTERVAL=10
